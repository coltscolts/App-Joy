# Copia este archivo a .env para desarrollo local.
# En compilaciones EAS, define estas variables con `eas env:create`
# (entornos development / preview / production).

# URL completa de la API. En local puedes dejarla vacía: la app usará
# la IP de tu ordenador con el puerto 8080.
EXPO_PUBLIC_API_URL=

# Clave pública de Clerk (pk_test_… o pk_live_…)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Opcional: proxy de Clerk
EXPO_PUBLIC_CLERK_PROXY_URL=
