{
  "expo": {
    "name": "JoyPlann",
    "slug": "joyplann",
    "owner": "edghs-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "joyplann",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joyplann.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "appleTeamId": "J5Z6FUTFMS",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.joyplann.app"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "package": "com.joyplann.app"
    },
    "web": {
      "favicon": "./assets/images/logo-joyplann.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F9",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#08162B"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2b3a7a"
        }
      ],
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JoyPlann uses your photos only when you choose a booking screenshot (flight, hotel or restaurant) to fill in your trip details.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withPodsMinimumDeploymentTarget",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JoyPlann only uses your location if you choose to see where you are on your trip map.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationAlwaysAndWhenInUsePermission": "JoyPlann only uses your location if you choose to see where you are on your trip map.",
          "locationAlwaysPermission": "JoyPlann only uses your location if you choose to see where you are on your trip map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "83d49689-5ba9-4e23-b2c6-6242d4880927"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/83d49689-5ba9-4e23-b2c6-6242d4880927",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
