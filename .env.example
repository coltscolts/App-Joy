# ---- API (artifacts/api-server) ----
DATABASE_URL=postgres://usuario:password@host:5432/joyplann   # obligatorio
PORT=8080
CLERK_SECRET_KEY=sk_test_xxx                                   # obligatorio (autenticación)
CLERK_PUBLISHABLE_KEY=pk_test_xxx                              # obligatorio
CLERK_PROXY_URL=                                               # opcional
OPENAI_API_KEY=                                                # opcional: sugerencias con IA
OPENAI_BASE_URL=                                               # opcional: endpoint compatible OpenAI
OPENAI_MODEL=gpt-4o-mini                                       # opcional
# (En Replit se usan AI_INTEGRATIONS_OPENAI_API_KEY / _BASE_URL, también admitidas)
GOOGLE_PLACES_API_KEY=                                         # opcional: búsqueda de hoteles
AVIATIONSTACK_API_KEY=                                         # opcional: datos de vuelos
LOG_LEVEL=info

# ---- Web (artifacts/travel-app) ----
API_PROXY_TARGET=http://localhost:8080      # solo desarrollo: adónde redirige /api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLERK_PROXY_URL=

# ---- Móvil (artifacts/trip-planner-mobile) ----
# Ver artifacts/trip-planner-mobile/.env.example (para EAS se usan `eas env`)
EXPO_PUBLIC_API_URL=https://api.tudominio.com   # vacío en local = IP de tu ordenador:8080
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_CLERK_PROXY_URL=
