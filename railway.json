{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @workspace/travel-app run build && pnpm --filter @workspace/api-server run build",
    "watchPatterns": ["artifacts/api-server/**", "artifacts/travel-app/**", "lib/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @workspace/db run migrate"],
    "startCommand": "pnpm --filter @workspace/api-server run start",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
