{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:multidestination": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/trip-routes.test.ts ../artifacts/api-server/src/booking-extraction.test.ts ../artifacts/api-server/src/billing.test.ts ../lib/api-client-react/src/itinerary.test.ts",
    "test:mobile-form": "vitest run --config artifacts/trip-planner-mobile/vitest.config.ts",
    "test:theme-startup": "vitest run --config artifacts/trip-planner-mobile/vitest.config.ts artifacts/trip-planner-mobile/components/ThemeStartup.integration.test.tsx && vitest run --config artifacts/travel-app/vitest.config.ts artifacts/travel-app/src/pages/Profile.theme.test.tsx"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  }
}
